<?xml version="1.0" encoding="utf-8"?>
<!-- Filled in light mode; black with a white outline in dark mode. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bark_component_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bark_component_fill" />
            <stroke android:width="1dp" android:color="@color/bark_component_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
