<?xml version="1.0" encoding="utf-8"?>
<!-- mooknote-style message detail dialog: 12dp surface card, text actions + filled close. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    app:cardBackgroundColor="@color/bark_component_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardForegroundColor="@android:color/transparent"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/bark_component_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="start"
            android:text="消息详情"
            android:textAlignment="viewStart"
            android:textColor="@color/bark_component_text"
            android:textIsSelectable="true"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/dialogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:textColor="@color/bark_component_text_secondary"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <!-- Message Body Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fadeScrollbars="false"
                android:paddingVertical="4dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/dialogBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:lineSpacingMultiplier="1.5"
                    android:textAlignment="viewStart"
                    android:textColor="@color/bark_component_text"
                    android:textColorLink="@color/bark_component_text"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

        <!-- mooknote-style actions: text buttons on the left, filled close on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOpenUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_md3_text_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="打开链接"
                android:textColor="@color/bark_component_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_md3_text_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="复制"
                android:textColor="@color/bark_component_text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_md3_button_filled"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="关闭"
                android:textColor="@color/bark_component_fill_text"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
